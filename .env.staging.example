# Copy this to .env.staging on the staging Docker host (NOT committed to git).
# Values marked <...> should come from GitHub Secrets, written to the host
# by the deploy workflow (or set once manually on first provisioning).

IMAGE_TAG=ghcr.io/bintangdemarta/sf-tracker:staging
APP_PORT=8080

APP_NAME="SF-Tracker (Staging)"
APP_ENV=staging
APP_DEBUG=true
APP_KEY=<generate with: php artisan key:generate --show>
APP_URL=<internal domain or tunnel URL, e.g. https://staging.sf-tracker.internal>

DB_DATABASE=sf_tracker_staging
DB_USERNAME=sf_tracker
DB_PASSWORD=<strong random password>
