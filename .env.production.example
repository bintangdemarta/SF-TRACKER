# Copy this to .env.production on the production VPS (NOT committed to git).
# Values marked <...> should come from GitHub Secrets, written to the host
# by the deploy workflow (or set once manually on first provisioning).
#
# NOTE: this file only covers the app/db container env. TLS termination
# (Let's Encrypt cert, reverse proxy) is NOT included yet — see devplan.md
# Phase 10 backlog. Until that's set up, APP_PORT should sit behind whatever
# reverse proxy the VPS ends up using.

IMAGE_TAG=ghcr.io/bintangdemarta/sf-tracker:main
APP_PORT=8080

APP_NAME="SF-Tracker"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generate with: php artisan key:generate --show>
APP_URL=<production domain, e.g. https://sf-tracker.com>

DB_DATABASE=sf_tracker
DB_USERNAME=sf_tracker
DB_PASSWORD=<strong random password, different from staging>
